# Configuración de Kafka y MongoDB
KAFKA_BROKERS=localhost:9092,localhost:29092
MONGO_URI=mongodb://localhost:27017/rutasur?replicaSet=rs0&directConnection=true

# Factor de aceleración temporal (1 hora simulada = 30 seg reales -> 120x)
ACCELERATION_FACTOR=120

# URLs de microservicios para el frontend
SIMULADOR_URL=http://localhost:3001
ANALITICA_URL=http://localhost:3002
